# =============================================================================
# PRODUCTION environment template.
#
# Copy to .env on the production host and fill in the four secrets. Startup
# refuses to boot on most mistakes rather than serving them to users, so if
# the service starts, the configuration is structurally sound.
#
# Never commit the filled-in file. Never paste it into a chat, an issue, or a
# ticket -- it carries three live credentials.
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# ---- OpenAI --------------------------------------------------------------
# Rotate this if it has ever been shared. A leaked key is billable by anyone.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT=20
OPENAI_MAX_RETRIES=2

# ---- Backend integration -------------------------------------------------
# backend_api is the only mode: the service reads the live database through
# the internal API.
BACKEND_INTEGRATION_MODE=backend_api

# No trailing slash needed. A path is fine: https://host/MyFi/api resolves to
# https://host/MyFi/api/internal/transactions
BACKEND_API_BASE_URL=

# MUST be non-empty and MUST match what the backend checks the Authorization
# header against. An empty value still sends "Authorization: Bearer " on every
# call, the backend rejects all of them, and the assistant answers "your
# figures are temporarily unavailable" to every question. Startup now refuses
# to boot on this, in every environment.
BACKEND_API_SERVICE_TOKEN=

# 30s, not 10s. A period comparison fetches two transaction windows and a
# merchant question can reach back six months -- tens to hundreds of kilobytes
# for an active user.
BACKEND_API_TIMEOUT_SECONDS=30

# ---- Security ------------------------------------------------------------
# 32+ bytes for HS256 (RFC 7518 3.2); startup rejects anything shorter.
# Generate with: openssl rand -hex 32
SERVICE_JWT_SECRET=
SERVICE_JWT_ALGORITHM=HS256
SERVICE_JWT_AUDIENCE=
SERVICE_JWT_ISSUER=
SERVICE_JWT_LEEWAY_SECONDS=30
SERVICE_JWT_MAX_LIFETIME_SECONDS=900

# The mobile app calls Laravel, and Laravel calls this service, so browsers
# never reach it directly and no origins need allowing. Add one only if a
# browser genuinely calls this service.
CORS_ALLOWED_ORIGINS=

# Turn ON once the backend populates owner_user_id on every record. The
# service logs `records_without_owner_user_id` once per endpoint that omits
# it -- when those lines stop appearing, flip this and you will know it is
# safe rather than guessing.
STRICT_DATA_OWNERSHIP=true

# Per user, per minute, per INSTANCE (the limiter is in-process). With more
# than one instance the effective ceiling is this value times the instance
# count.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ---- Conversation memory -------------------------------------------------
# memory      = process-local. Lost on restart, NOT shared across instances or
#               workers, so a follow-up turn can hit a process that never heard
#               of the user. Nothing errors; the assistant just forgets.
# backend_api = persisted through /internal/conversations/* (handover §8).
#
# While this is `memory` you MUST run a SINGLE instance and a SINGLE worker,
# and set ALLOW_IN_MEMORY_CONVERSATIONS=true to say so deliberately -- startup
# refuses production otherwise.
CONVERSATION_STORAGE=memory
ALLOW_IN_MEMORY_CONVERSATIONS=true

CONVERSATION_RECENT_MESSAGE_LIMIT=12
CONVERSATION_SUMMARY_TRIGGER_LENGTH=24

# ---- Logging -------------------------------------------------------------
# JSON for log aggregators. Either way the structured fields are emitted, so
# `backend_request_failed` carries the path and status code that separate
# "endpoint missing" from "token wrong". Secrets are redacted in both formats.
LOG_LEVEL=INFO
JSON_LOGS=true
