# Copy to .env and fill in real values. Never commit the real .env file.

# ---- App ----
ENVIRONMENT=local
DEBUG=false

# ---- OpenAI ----
# NEVER put a real key in this file -- it is committed to the repository.
# Real values belong in .env, which is gitignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT=20
OPENAI_MAX_RETRIES=2
# OPENAI_BASE_URL=

# ---- Backend integration ----
# One of: backend_api | read_only_db | mock
BACKEND_INTEGRATION_MODE=mock
# BACKEND_API_BASE_URL=https://internal-backend.example.com
BACKEND_API_TIMEOUT_SECONDS=30
BACKEND_API_SERVICE_TOKEN=

# ---- Security ----
# Shared secret used to verify the service-to-service JWT the existing
# backend issues asserting the authenticated user's identity.
# Must be >= 32 bytes for HS256 (RFC 7518 3.2). Startup REFUSES to boot in
# production if this is empty or too short.
SERVICE_JWT_SECRET=
SERVICE_JWT_ALGORITHM=HS256
# Optional. If the issuing backend sets `aud`/`iss` on its tokens, set these so
# a token minted for another service cannot be replayed against this one.
SERVICE_JWT_AUDIENCE=
SERVICE_JWT_ISSUER=
# Clock-skew tolerance between this service and the issuing backend.
SERVICE_JWT_LEEWAY_SECONDS=30
# Reject validly-signed tokens with a longer lifetime than this (needs `iat`).
# 0 disables. Service-to-service assertions should be short-lived.
SERVICE_JWT_MAX_LIFETIME_SECONDS=900
CORS_ALLOWED_ORIGINS=
# Reject financial records that don't declare `owner_user_id` instead of
# accepting them unverified. Turn this ON once the backend stamps ownership on
# every record — it converts an unverifiable blind spot into a hard failure.
# Verify every record the backend returns actually belongs to the requesting
# user. Records declare this via `owner_user_id`; when the backend omits the
# field the check cannot run, which is why this is a switch and not a
# constant. Leave false ONLY until the backend populates it on every record --
# the service logs `records_without_owner_user_id` once per endpoint that
# omits it, so you can confirm from logs before turning this on.
# TURN THIS ON IN PRODUCTION once those log lines stop appearing.
STRICT_DATA_OWNERSHIP=false
# Per-user cap on chat requests. Each turn costs 2-3 OpenAI calls, so this is
# a budget control as much as an abuse control. Enforced per instance.
# 0 disables throttling entirely.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Conversation history is stored in process memory: lost on restart, not
# shared across instances. Production refuses to boot unless this is true.
ALLOW_IN_MEMORY_CONVERSATIONS=false

# ---- Conversation memory ----
# Where chat history lives.
#   memory      = process-local. Lost on restart, NOT shared between instances,
#                 so behind a load balancer a user's second turn can hit a
#                 process that never heard of them. Nothing errors -- the
#                 assistant just forgets mid-conversation. Local dev only.
#   backend_api = persisted through the backend's /internal/conversations/*
#                 endpoints (docs/handover-backend.md section 8). Requires the
#                 three extra chat_messages columns in section 8.1.
# PRODUCTION SHOULD USE backend_api once those endpoints exist; startup refuses
# `memory` in production unless ALLOW_IN_MEMORY_CONVERSATIONS=true.
CONVERSATION_STORAGE=memory
CONVERSATION_RECENT_MESSAGE_LIMIT=12
CONVERSATION_SUMMARY_TRIGGER_LENGTH=24

# ---- Logging ----
LOG_LEVEL=INFO
JSON_LOGS=true
