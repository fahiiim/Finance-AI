# Real secrets never get committed; the *.example templates always do -- they
# are the only documentation of which variables exist, and a template that is
# ignored is a template nobody on the team ever sees.
.env
.env.*
!.env.example
!.env.production.example

__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# Database dumps and snapshots — these contain real customer financial data
# and must never be committed. 169 MB of live PII is one `git add .` away.
#
# Database exports hold real customer names, emails and balances. None of
# these formats belongs in the repository.
*.sql
*.dump
*.sql.gz
*.db
data/

.DS_Store
